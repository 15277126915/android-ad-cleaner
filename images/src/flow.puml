@startuml
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 15
skinparam backgroundColor #FFFFFF
skinparam dpi 160
skinparam ActivityBackgroundColor #F4F7FB
skinparam ActivityBorderColor #3B6FD8
skinparam ActivityDiamondBackgroundColor #FFF6E0
skinparam ArrowColor #555555
title 一次完整的处理流程
start
:手机打开 USB 调试，连上电脑;
:run.py devices\n认出型号和系统版本;
:run.py check\n锁屏？有没有机型脚本？;
:run.py backup\n存一份改动前的快照;
if (有本机型机型脚本？) then (有)
  :run.py recipe\n逐个 App 关广告开关;
else (没有)
  :照 docs/清单 手动关\n或用 explore.py 探路;
endif
:run.py chan-scan\n列出营销通知渠道;
:人工核对清单\n删掉服务类渠道;
:run.py chan-off\n关掉营销渠道;
if (机主同意挂起广告包？) then (同意)
  :run.py suspend;
else (不同意)
endif
:run.py quickapp\n检测快应用;
if (机主同意关闭快应用？) then (同意)
  :run.py quickapp off;
else (不同意)
endif
:run.py finish\n插电常亮改回原值;
:提醒关闭开发者模式\n手机上关，或 run.py dev-off;
stop
@enduml
